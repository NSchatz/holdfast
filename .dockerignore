# Keep the build context to what the image actually needs: the Go source, LICENSE and
# NOTICE (the image redistributes binaries, so it carries its licences with it). The
# version stamp comes from build ARGs (VERSION/COMMIT/DATE), never from .git.
.git
.github
.gitignore
docs
README.md
CLAUDE.md

# Local artifacts, and anything that could carry real config or state into an image.
holdfast
transcode
dist
out
state
config.yaml
docker-compose.yml

# The web UI's dependencies and build output: the image installs and builds its own, in
# the `ui` stage, from the lockfile. A developer's built UI in the embed directory stays
# out too - only its committed placeholder is sent.
web/node_modules
web/dist
internal/ui/dist/*
!internal/ui/dist/.gitkeep
