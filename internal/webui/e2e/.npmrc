# Lifecycle scripts are DISABLED for the dashboard's grader project.
#
# Installing a manifest with them enabled lets every transitive dependency run arbitrary
# preinstall/postinstall code on a runner holding this repository's credentials. Nothing
# here needs that, and the one script that would run is one this project actively does not
# want: @playwright/test's postinstall downloads its own browser builds.
#
# These graders use the browser the machine already has - located by HOLDFAST_BROWSER or
# from PATH, the same way every other grader in this repository locates one - so a download
# here would put an unpinned, undigested browser in the path of a project whose entire
# packaging story is a pinned, digest-verified artifact. It would also be a second engine:
# the gate would then be measuring a browser nobody chose against a page it ships to
# readers using theirs.
ignore-scripts=true
